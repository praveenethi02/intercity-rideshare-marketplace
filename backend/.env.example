# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml. Change the password for anything other than local development.
DATABASE_URL=postgres://rideshare:rideshare_dev@localhost:5432/rideshare

# Comma-separated list of web origins allowed by CORS. Mobile apps are not affected.
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API. Keep 0 when running it directly.
TRUST_PROXY=0

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# "console" prints OTP codes to the server log and is refused when NODE_ENV=production.
SMS_PROVIDER=console

# Used only by "npm run seed:admin".
ADMIN_NAME=System Admin
ADMIN_PHONE=
ADMIN_PASSWORD=

RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=30
